{
  "$comment": "MCP servers bundled by the toolkit. kind: npm (seeded into caches/npm-cache, installed globally), pip (caches/pip-wheelhouse, installed into ~/.venv-mcp), bin (caches/mcp-bin). default=true servers are registered in ~/.claude.json by the install scripts; the rest are installed and listed in ~/agent-toolkit-docs/mcp-servers.md with a ready 'claude mcp add' line. env values are placeholders for you to fill.",
  "servers": [
    { "id": "playwright",          "kind": "npm", "package": "@playwright/mcp",                               "bin": "playwright-mcp",                 "default": true,  "args": ["--headless"], "note": "Browser automation. Uses the bundled Playwright Chromium." },
    { "id": "chrome-devtools",     "kind": "npm", "package": "chrome-devtools-mcp",                           "bin": "chrome-devtools-mcp",            "default": false, "args": [], "note": "Google's Chrome DevTools MCP. Pass --executablePath to a Chrome or the Playwright Chromium if Chrome is absent." },
    { "id": "filesystem",          "kind": "npm", "package": "@modelcontextprotocol/server-filesystem",       "bin": "mcp-server-filesystem",          "default": false, "args": ["${HOME}"], "note": "Official filesystem server. Claude Code's own tools cover this; useful for other MCP clients." },
    { "id": "memory",              "kind": "npm", "package": "@modelcontextprotocol/server-memory",           "bin": "mcp-server-memory",              "default": true,  "args": [], "env": { "MEMORY_FILE_PATH": "${HOME}/.claude/mcp-memory.jsonl" }, "note": "Persistent knowledge graph across sessions." },
    { "id": "sequential-thinking", "kind": "npm", "package": "@modelcontextprotocol/server-sequential-thinking", "bin": "mcp-server-sequential-thinking", "default": true,  "args": [], "note": "Structured step-by-step reasoning tool." },
    { "id": "desktop-commander",   "kind": "npm", "package": "@wonderwhy-er/desktop-commander",               "bin": "desktop-commander",              "default": true,  "args": [], "note": "Persistent shells, REPLs and file ops." },
    { "id": "dbhub",               "kind": "npm", "package": "@bytebase/dbhub",                               "bin": "dbhub",                          "default": false, "args": ["--transport", "stdio", "--dsn", "postgres://user:pass@host:5432/db"], "note": "One server for Postgres, MySQL, MariaDB, SQL Server and SQLite. Add --readonly for safety." },
    { "id": "mongodb",             "kind": "npm", "package": "mongodb-mcp-server",                            "bin": "mongodb-mcp-server",             "default": false, "args": [], "env": { "MDB_MCP_CONNECTION_STRING": "mongodb://host:27017/db" }, "note": "Official MongoDB server." },
    { "id": "kubernetes",          "kind": "npm", "package": "mcp-server-kubernetes",                         "bin": "mcp-server-kubernetes",          "default": false, "args": [], "note": "Uses the current kubeconfig context." },
    { "id": "gitlab",              "kind": "npm", "package": "@zereight/mcp-gitlab",                          "bin": "mcp-gitlab",                     "default": false, "args": [], "env": { "GITLAB_API_URL": "https://gitlab.internal/api/v4", "GITLAB_PERSONAL_ACCESS_TOKEN": "<token>" }, "note": "Self-hosted GitLab works via GITLAB_API_URL." },
    { "id": "task-master",         "kind": "npm", "package": "task-master-ai",                                "bin": "task-master-ai",                 "default": false, "args": [], "env": { "ANTHROPIC_API_KEY": "<key>", "ANTHROPIC_BASE_URL": "https://llm-gateway.internal/anthropic" }, "note": "PRD-to-tasks planner. Calls a model itself, so point it at the internal gateway." },
    { "id": "mcp-remote",          "kind": "npm", "package": "mcp-remote",                                    "bin": "mcp-remote",                     "default": false, "args": ["https://mcp.internal/sse"], "note": "Bridge to any remote HTTP/SSE MCP server on the internal network." },
    { "id": "inspector",           "kind": "npm", "package": "@modelcontextprotocol/inspector",               "bin": "mcp-inspector",                  "default": false, "args": [], "note": "Debugging UI for MCP servers; a dev tool, not a server to register." },

    { "id": "git",        "kind": "pip", "package": "mcp-server-git",   "bin": "mcp-server-git",   "default": false, "args": ["--repository", "${CWD}"], "note": "Official Git server. Claude Code's Bash covers git; useful for other clients." },
    { "id": "fetch",      "kind": "pip", "package": "mcp-server-fetch", "bin": "mcp-server-fetch", "default": true,  "args": [], "note": "Fetches URLs and converts to markdown. Works against internal sites." },
    { "id": "time",       "kind": "pip", "package": "mcp-server-time",  "bin": "mcp-server-time",  "default": false, "args": [], "note": "Time and timezone conversions." },
    { "id": "markitdown", "kind": "pip", "package": "markitdown-mcp",   "bin": "markitdown-mcp",   "default": true,  "args": [], "note": "Microsoft MarkItDown: PDF, Office, HTML and more to markdown." },
    { "id": "atlassian",  "kind": "pip", "package": "mcp-atlassian",    "bin": "mcp-atlassian",    "default": false, "args": [], "env": { "JIRA_URL": "https://jira.internal", "JIRA_PERSONAL_TOKEN": "<token>", "CONFLUENCE_URL": "https://confluence.internal", "CONFLUENCE_PERSONAL_TOKEN": "<token>" }, "note": "Jira and Confluence, Server/Data Center supported." },
    { "id": "serena",     "kind": "pip", "package": "serena-agent",     "bin": "serena",           "default": false, "args": ["start-mcp-server", "--context", "ide-assistant", "--project", "${CWD}"], "note": "Symbol-level code navigation and editing via language servers." },

    { "id": "github", "kind": "bin", "package": "github/github-mcp-server", "bin": "github-mcp-server", "default": false, "args": ["stdio"], "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "<token>", "GITHUB_HOST": "https://github.internal" }, "note": "Official GitHub server as a static binary; set GITHUB_HOST for GitHub Enterprise." }
  ]
}
