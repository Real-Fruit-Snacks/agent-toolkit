# Binaries and caches ship as GitHub release assets, not in git.
# Keep only scripts, config, docs, and small manifests in the repo.
windows/*
linux/*
wsl/*
caches/*
!windows/SHA256SUMS
!windows/nightly.yml
!windows/SHASUMS256-node-*.txt
!windows/claude-code/
windows/claude-code/*
!windows/claude-code/manifest.json
!windows/claude-code/VERSION
!windows/claude-code/install.ps1
!linux/claude-code/
linux/claude-code/*
!linux/claude-code/VERSION
!linux/claude-code/install.sh
!wsl/ubuntu-noble-SHA256SUMS
!caches/t3-userdata/
release/
*.log
